{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-Wall",
                "-Wextra",
                "-Wconversion",
                "-std=c11",
                "-static",
                "-fno-asm",
                "-lm",
                "-g",
                "-o",
                "${workspaceFolder}\\build\\${fileBasenameNoExtension}.exe",
                "${file}",
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
        },
    ]
}