{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "builddir",
            "type": "shell",
            "command": "mkdir",
            "args": [
                "-Force",
                "${workspaceFolder}\\build\\${relativeFileDirname}"
            ],
        },
        {
            "label": "build",
            "type": "shell",
            "command": "g++",
            "args": [
                "-Wall",
                "-Wextra",
                "-Wconversion",
                "-static",
                "-g",
                "-std=c++23",
                "-lstdc++exp",
                "-o",
                "${workspaceFolder}\\build\\${relativeFileDirname}\\${fileBasenameNoExtension}.exe",
                "${file}",
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "dependsOn": "builddir",
        },
    ]
}